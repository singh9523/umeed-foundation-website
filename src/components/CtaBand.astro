---
import Icon from './Icon.astro';
interface Props { heading?: string; text?: string }
const {
  heading = 'Be a part of this ray of hope',
  text = 'Every meal, every set of clothes and every hour of mentoring starts with someone who chose to help.',
} = Astro.props;
const ways = [
  { icon: 'gift', title: 'Donate', text: 'Support our ration, clothing and education drives.', href: '/donate', cta: 'Ways to give' },
  { icon: 'people', title: 'Volunteer', text: 'Give your time and skills at our drives and programmes.', href: '/get-involved#volunteer', cta: 'Join as a volunteer' },
  { icon: 'building', title: 'Partner with us', text: 'Sponsor a campaign or work with us through CSR.', href: '/get-involved#partner', cta: 'Start a partnership' },
];
---
<section class="section section--plum cta-band">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="eyebrow">Get involved</span>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="grid grid-3">
      {ways.map((w) => (
        <a class="way" href={w.href}>
          <span class="icon-badge"><Icon name={w.icon} /></span>
          <span class="way-title">{w.title}</span>
          <span class="way-text">{w.text}</span>
          <span class="way-cta">{w.cta} →</span>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .way {
    display: flex; flex-direction: column; gap: 0.25rem; text-decoration: none; color: #e6dbee;
    padding: 1.75rem; border-radius: var(--radius-lg); border: 1px solid rgb(255 255 255 / 14%);
    background: rgb(255 255 255 / 4%); transition: background-color 0.2s, border-color 0.2s;
  }
  .way:hover { background: rgb(255 255 255 / 8%); border-color: var(--gold-400); color: #e6dbee; }
  .way .icon-badge { background: var(--gold-400); color: var(--plum-950); }
  .way-title { font-family: var(--font-display); font-size: 1.45rem; color: #fff; }
  .way-text { flex: 1; }
  .way-cta { color: var(--gold-300); font-weight: 600; margin-top: 0.75rem; }
</style>
