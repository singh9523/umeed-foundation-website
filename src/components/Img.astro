---
/**
 * Displays an image from the content files. Local uploads are automatically
 * resized/compressed; external links are shown as-is.
 */
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  src?: string | null;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const { src, alt, widths = [480, 800, 1200], sizes = '100vw', class: className, loading = 'lazy', fetchpriority } = Astro.props;
const image = resolveImage(src);
---
{image && typeof image !== 'string' && (
  <Image
    src={image}
    alt={alt}
    widths={widths.filter((w) => w <= image.width).concat(widths.some((w) => w > image.width) ? [image.width] : [])}
    sizes={sizes}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    format="webp"
    quality={80}
  />
)}
{typeof image === 'string' && <img src={image} alt={alt} class={className} loading={loading} decoding="async" />}
