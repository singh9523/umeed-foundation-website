---
/** Small inline SVG icon set (stroke icons, inherit the current text colour). */
interface Props { name: string; size?: number | string; label?: string; class?: string }
const { name, size = 24, label, class: className } = Astro.props;

const paths: Record<string, string> = {
  book: '<path d="M12 6.5C10 5 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.5 2-1.5 5-2 8.5-1.5V5C17 4.5 14 5 12 6.5Z"/><path d="M12 6.5v13"/>',
