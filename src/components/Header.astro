---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { mainNav } from '../lib/nav';
import settings from '../data/settings.json';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${settings.name} — home`}>
      <Image src={logo} alt="" width={52} height={52} densities={[1, 2]} loading="eager" class="brand-logo" />
      <span class="brand-text">
        <span class="brand-name">Umeed Foundation</span>
        <span class="brand-tag">A Ray of Hope</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
        <span class="icon-open"><Icon name="menu" /></span>
        <span class="icon-close"><Icon name="close" /></span>
        <span class="sr-only">Menu</span>
      </button>
      <ul id="nav-menu" class="nav-menu">
        {mainNav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li class="nav-cta"><a class="btn btn--gold" href="/donate" aria-current={isActive('/donate') ? 'page' : undefined}>Donate</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('nav-open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    window.matchMedia('(min-width: 960px)').addEventListener('change', () => set(false));
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(251 248 242 / 92%); backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.5rem; }
  .brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: inherit; }
  .brand-logo { width: 52px; height: 52px; border-radius: 50%; }
  .brand-text { display: grid; line-height: 1.1; }
  .brand-name { font-family: var(--font-display); font-weight: 650; font-size: 1.2rem; color: var(--plum-800); }
  .brand-tag { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-700); font-weight: 600; }

  .nav-menu { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 0.25rem; }
  .nav-menu a:not(.btn) {
    display: block; padding: 0.5rem 0.75rem; border-radius: 8px; text-decoration: none;
    color: var(--ink); font-weight: 500; font-size: 1rem;
  }
  .nav-menu a:not(.btn):hover { background: var(--plum-100); color: var(--plum-800); }
  .nav-menu a[aria-current='page']:not(.btn) { color: var(--plum-700); box-shadow: inset 0 -2px 0 var(--gold-500); border-radius: 0; }
  .nav-cta { margin-left: 0.5rem; }
  .nav-toggle {
    display: none; background: none; border: 0; padding: 0.5rem; color: var(--plum-800); cursor: pointer; border-radius: 8px;
  }
  .nav-toggle .icon-close { display: none; }

  @media (max-width: 959px) {
    .nav-toggle { display: inline-flex; }
    :global(body.nav-open) .nav-toggle .icon-open { display: none; }
    :global(body.nav-open) .nav-toggle .icon-close { display: inline; }
    .nav-menu {
      display: none; position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--cream); border-bottom: 1px solid var(--line);
      padding: 0.5rem var(--gutter) 1.25rem; box-shadow: 0 12px 24px rgb(43 16 57 / 10%);
      max-height: calc(100dvh - 4.5rem); overflow-y: auto;
    }
    :global(body.nav-open) .nav-menu { display: flex; }
    .nav-menu a:not(.btn) { padding: 0.85rem 0.25rem; border-bottom: 1px solid var(--line); border-radius: 0; font-size: 1.075rem; }
    .nav-menu a[aria-current='page']:not(.btn) { box-shadow: inset 3px 0 0 var(--gold-500); padding-left: 0.85rem; }
    .nav-cta { margin: 1rem 0 0; }
    .nav-cta .btn { width: 100%; }
  }
  @media (max-width: 380px) { .brand-tag { display: none; } }
</style>
