---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import settings from '../data/settings.json';

const d = settings.donation;
const reg = settings.registration;
const programmes = (await getCollection('programmes')).sort((a, b) => a.data.order - b.data.order);

const razorpayId = d.razorpay_payment_button_id?.trim();
const hasUpi = Boolean(d.upi_id?.trim());
const upiLink = hasUpi
  ? `upi://pay?pa=${encodeURIComponent(d.upi_id.trim())}&pn=${encodeURIComponent(d.upi_payee_name || settings.name)}&cu=INR`
  : '';
const hasBank = Boolean(d.bank_account_number?.trim() && d.bank_ifsc?.trim());
---
<BaseLayout title="Donate" description="Support Umeed Foundation's ration, clothing and education work.">
  <PageHero eyebrow="Donate" title="Your support keeps hope alive." text="Your contribution helps us bring food, clothing and education to families and children who need them most." />

  <section class="section">
    <div class="container split top">
      <div>
        <span class="eyebrow">Give online</span>
        {razorpayId ? (
          <>
            <h2>Donate securely online</h2>
            <p class="lead">Payments are processed securely by Razorpay. We never see or store your card or bank details.</p>
            <form class="rzp"><script is:inline src="https://checkout.razorpay.com/v1/payment-button.js" data-payment_button_id={razorpayId} async></script></form>
          </>
        ) : (
          <>
            <h2>Online donations are coming soon</h2>
            <p class="lead">We are setting up secure online payments. Until then, you can support us in the ways below — or contact us and we'll guide you.</p>
          </>
        )}

        {hasUpi && (
          <div class="card pay">
            <h3><Icon name="phone" size={22} /> Pay by UPI</h3>
            <p>UPI ID: <strong class="mono">{d.upi_id}</strong>{d.upi_payee_name && <> · {d.upi_payee_name}</>}</p>
            {d.upi_qr && <div class="qr"><Img src={d.upi_qr} alt={`UPI QR code for ${d.upi_payee_name || settings.name}`} widths={[300]} sizes="220px" /></div>}
            <a class="btn btn--gold mobile-only" href={upiLink}>Open in UPI app</a>
            <p class="muted small">Please check that the payee name matches before paying.</p>
          </div>
        )}

        {hasBank && (
          <div class="card pay">
            <h3><Icon name="building" size={22} /> Bank transfer</h3>
            <dl>
              {d.bank_account_name && <><dt>Account name</dt><dd>{d.bank_account_name}</dd></>}
              <dt>Account number</dt><dd class="mono">{d.bank_account_number}</dd>
              <dt>IFSC</dt><dd class="mono">{d.bank_ifsc}</dd>
              {d.bank_name && <><dt>Bank</dt><dd>{d.bank_name}{d.bank_branch && `, ${d.bank_branch}`}</dd></>}
            </dl>
          </div>
        )}

        <div class="card pay">
          <h3><Icon name="gift" size={22} /> Donate in kind</h3>
          <p>Clothes, sarees, ration and books are used directly in our drives.</p>
          <a class="text-link" href="/contact">Contact us to arrange a donation</a>
        </div>

        {!hasUpi && !hasBank && !razorpayId && (
          <div class="card pay">
            <h3><Icon name="mail" size={22} /> Talk to us</h3>
            <p>Want to make a financial contribution or sponsor a drive? Send us a message and our trustees will get back to you.</p>
            <a class="btn" href="/contact">Contact us</a>
          </div>
        )}
      </div>

      <aside class="aside">
        <div class="card">
          <h3>Where your support goes</h3>
          <ul class="where">
            {programmes.map((p) => (
              <li><Icon name={p.data.icon} size={22} /><div><strong>{p.data.title}</strong><span class="muted">{p.data.summary}</span></div></li>
            ))}
          </ul>
        </div>
        <div class="card trust">
          <h3><Icon name="shield" size={22} /> Transparency</h3>
          <ul>
            <li>We are a registered foundation{reg.type && ` (${reg.type})`}, guided by a Board of Trustees.</li>
            {reg.tax_exemption ? <li>{reg.tax_exemption}</li> : <li>Details of tax exemption (80G) will be published here when available.</li>}
            <li>Milestones and reports are published on our <a href="/impact">Impact page</a>.</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .top { align-items: start; }
  .pay { margin-top: 1.25rem; }
  .pay h3, .trust h3 { display: flex; align-items: center; gap: 0.6rem; }
  .pay h3 :global(svg), .trust h3 :global(svg) { color: var(--plum-700); }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.95em; }
  .qr { max-width: 220px; margin: 0.5rem 0 1rem; border: 1px solid var(--line); border-radius: var(--radius); padding: 0.5rem; background: #fff; }
  .small { font-size: 0.875rem; margin: 0.75rem 0 0; }
  .mobile-only { display: none; }
  @media (hover: none) and (pointer: coarse) { .mobile-only { display: inline-flex; } }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 1.25rem; margin: 0; }
  dt { font-weight: 600; }
  dd { margin: 0; }
  .aside { display: grid; gap: 1.25rem; }
  @media (min-width: 960px) { .aside { position: sticky; top: 6rem; } }
  .where { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .where li { display: flex; gap: 0.8rem; }
  .where li :global(svg) { color: var(--gold-700); flex: none; margin-top: 0.2rem; }
  .where div { display: grid; }
  .where .muted { font-size: 0.95rem; }
  .trust ul { padding-left: 1.1rem; margin: 0; display: grid; gap: 0.4rem; }
  .rzp { margin-top: 1rem; }
</style>
