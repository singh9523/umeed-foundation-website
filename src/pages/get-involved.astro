---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import settings from '../data/settings.json';

const otherWays = [
  { icon: 'gift', title: 'Donate in kind', text: 'Clothes, sarees, ration and books help directly in our drives. Contact us to arrange a drop-off or pick-up.', href: '/contact', cta: 'Contact us' },
  { icon: 'heart', title: 'Sponsor a drive', text: 'Local businesses and families sponsor our campaigns — like our cloth distribution drive, sponsored by The Style Adda and Niva Kumari.', href: '#partner', cta: 'Sponsor a campaign' },
  { icon: 'instagram', title: 'Spread the word', text: 'Follow us and share our posts. Every share helps us reach more supporters.', href: settings.social.instagram, cta: 'Follow on Instagram', external: true },
];
---
<BaseLayout title="Get involved" description="Volunteer with Umeed Foundation, sponsor a campaign, or partner with us through CSR.">
  <PageHero eyebrow="Get involved" title="Hope grows when it is shared." text="Whether you have an hour, a skill or resources to give, there is a place for you at Umeed Foundation.">
    <nav class="jump" aria-label="On this page">
      <a href="#volunteer">Volunteer</a><a href="#partner">Partner / CSR</a><a href="#other">Other ways to help</a>
    </nav>
  </PageHero>

  <section class="section" id="volunteer">
    <div class="container split top">
      <div>
        <span class="eyebrow">Volunteer</span>
        <h2>Give your time and skills</h2>
        <p class="lead">Volunteers are at the heart of our drives. You can help with:</p>
        <ul class="ticks">
          <li>Packing and distributing ration and clothing</li>
          <li>Teaching and mentoring children</li>
          <li>Organising events and community outreach</li>
          <li>Photography, design and social media</li>
          <li>Fundraising and finding sponsors</li>
        </ul>
        <p class="muted">Fill in the form and our team will get in touch about upcoming drives near you.</p>
      </div>
      <div class="card"><h3>Volunteer registration</h3><EnquiryForm kind="volunteer" /></div>
    </div>
  </section>

  <section class="section section--paper" id="partner">
    <div class="container split top">
      <div>
        <span class="eyebrow">Partners &amp; CSR</span>
        <h2>Work with us as an organisation</h2>
        <p class="lead">We welcome companies, institutions and local businesses who want to make a lasting difference.</p>
        <ul class="ticks">
          <li><strong>Campaign sponsorship</strong> — fund a ration, clothing or education drive, with recognition on our campaign materials.</li>
          <li><strong>CSR partnerships</strong> — long-term programmes in education, nutrition and dignity.</li>
          <li><strong>In-kind support</strong> — clothing, ration kits, books and learning materials.</li>
        </ul>
        <p class="muted small">We will share our registration and compliance documents with CSR partners on request.</p>
      </div>
      <div class="card"><h3>Partnership enquiry</h3><EnquiryForm kind="partner" /></div>
    </div>
  </section>

  <section class="section" id="other">
    <div class="container">
      <div class="section-head"><span class="eyebrow">More ways to help</span><h2>Every gesture counts</h2></div>
      <div class="grid grid-3">
        {otherWays.map((w) => (
          <div class="card way">
            <span class="icon-badge"><Icon name={w.icon} /></span>
            <h3>{w.title}</h3>
            <p class="muted">{w.text}</p>
            <a class="text-link" href={w.href} {...(w.external ? { target: '_blank', rel: 'noopener' } : {})}>{w.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.75rem; }
  .jump a { color: #fff; text-decoration: none; font-weight: 500; padding: 0.4rem 0.95rem; border: 1px solid rgb(255 255 255 / 25%); border-radius: 999px; font-size: 0.95rem; }
  .jump a:hover { background: rgb(255 255 255 / 10%); color: #fff; }
  .top { align-items: start; }
  .ticks { list-style: none; padding: 0; margin: 0 0 1.25rem; display: grid; gap: 0.6rem; }
  .ticks li { position: relative; padding-left: 1.75rem; }
  .ticks li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--gold-500); box-shadow: 0 0 0 3px #f6ecd6; }
  .small { font-size: 0.925rem; }
  .way { display: flex; flex-direction: column; }
  .way .muted { flex: 1; }
</style>
